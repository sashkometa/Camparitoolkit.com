      return;
    }

    var tab = e.target.closest('[data-tab]');
    if(tab){
      tab.parentElement.querySelectorAll('[data-tab]').forEach(function(x){ x.classList.remove('on'); });
      tab.classList.add('on');
      return;
    }

    if(e.target.id==='ui-gen'){ var o1=document.getElementById('ui-out'); if(o1) o1.style.display='block'; return; }
    if(e.target.id==='em-gen'){ var o2=document.getElementById('em-out'); if(o2) o2.style.display='block'; return; }
    if(e.target.id==='mv-gen'){ var o3=document.getElementById('mv-out'); if(o3) o3.style.display='block'; return; }
    if(e.target.id==='dc-gen'){ var o4=document.getElementById('dc-out'); if(o4) o4.style.display='block'; return; }
  });

  var sel = document.getElementById('f-prod');
  if(sel) sel.addEventListener('change', renderUi);
  renderUi();

})();
