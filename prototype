<script>
(function(){
  var titles = {
    cat:['Довідник','Довідник товарів'],
    ui:['Формування УІ та УГІ','Формування УІ'],
    ugi:['Формування УІ та УГІ','Внесення УГІ'],
    em:['Марки','Активація електронних марок'],
    move:['Марки','Особливі випадки переміщення'],
    deact:['Списання','Деактивація УІ, УГІ та ЕМ']
  };
  var actions = {
    cat:'<button class="btn">Завантажити файл довідника</button><button class="btn go">Додати товар</button>'
  };

  var app = document.getElementById('app');
  var crumb = document.getElementById('crumb');
  var title = document.getElementById('title');
  var acts = document.getElementById('acts');

  function go(id){
    var t = document.getElementById('s-'+id);
    if(!t) return;
    document.querySelectorAll('.screen').forEach(function(s){ s.classList.remove('on'); });
    t.classList.add('on');
    document.querySelectorAll('.side button').forEach(function(b){
      b.classList.toggle('active', b.getAttribute('data-go')===id);
    });
    var h = titles[id] || ['',''];
    crumb.textContent = h[0]; title.textContent = h[1];
    acts.innerHTML = actions[id] || '';
    if(id==='ui'){ var s=document.getElementById('f-prod'); if(s){ s.value=''; } renderUi(); }
    var v = document.querySelector('.view'); if(v) v.scrollTop = 0;
  }

  var PRODUCTS = {
    '100010':{name:'Віскі 10-річної витримки Glen Grant 10 years', bar:'080432402979', uktzed:'2208303000', cap:'0,7 л', abv:'40,0%', cn:'GBR', rate:'133,31'},
    '100003':{name:'Настоянка гірка CAMPARI, 0,7 л', bar:'8000040001106', uktzed:'2208701000', cap:'0,7 л', abv:'25,0%', cn:'ITA', rate:'133,31'},
    '435162':{name:'Аперитив APEROL APERITIVO, 1 л', bar:'8002230000012', uktzed:'2208906900', cap:'1,0 л', abv:'11,0%', cn:'ITA', rate:'133,31'},
    '100015':{name:'Текіла ESPOLON BLANCO', bar:'721059707503', uktzed:'2208905400', cap:'0,75 л', abv:'40,0%', cn:'MEX', rate:'133,31'},
    'rts':{name:null, bar:null, uktzed:'2208906900', cap:'0,2 л', abv:'9,0%', cn:'ITA', rate:'133,31', missing:['назва для еАкцизу','код товару','штрихкод']}
  };
  var BATCH = ['PTU00000001906','12 000','25.09.2026','25UA209130777558T4'];
  var FIELDS = ['f-b','f-q','f-d','f-dec'];

  function setText(id, v, bad){
    var el = document.getElementById(id); if(!el) return;
    el.textContent = (v === null || v === undefined) ? 'не заповнено' : v;
    el.style.color = bad ? 'var(--err)' : '';
  }

  function renderUi(){
    var sel = document.getElementById('f-prod');
    var empty = document.getElementById('ui-empty');
    var filled = document.getElementById('ui-filled');
    var head = document.getElementById('ui-head');
    var out = document.getElementById('ui-out');
    if(!sel || !empty || !filled) return;
    var code = sel.value;

    FIELDS.forEach(function(id,i){
      var f = document.getElementById(id); if(!f) return;
      f.disabled = !code; f.value = code ? BATCH[i] : '';
    });
    if(out) out.style.display = 'none';

    if(!code){
      empty.style.display='grid'; filled.style.display='none';
      head.innerHTML = 'Дані товару';
      return;
    }

    var p = PRODUCTS[code];
    empty.style.display='none'; filled.style.display='block';
    setText('d-name', p.name, !p.name);
    setText('d-bar', p.bar, !p.bar);
    setText('d-uktzed', p.uktzed); setText('d-cap', p.cap);
    setText('d-abv', p.abv); setText('d-cn', p.cn); setText('d-rate', p.rate);

    var chip = document.getElementById('ui-chip');
    var gen = document.getElementById('ui-gen');
    if(p.missing){
      head.innerHTML = 'Підставлено з довідника <span class="r"><span class="chip er">'+p.missing.length+' поля не заповнено</span></span>';
      chip.className='chip er'; chip.textContent='Не вистачає: '+p.missing.join(', ');
      gen.disabled = true;
    }else{
      head.innerHTML = 'Підставлено з довідника <span class="r"><span class="chip ok">усі поля знайдено</span></span>';
      chip.className='chip ok'; chip.textContent='12 000 УІ, усі поля заповнені';
      gen.disabled = false;
    }
  }

  document.addEventListener('click', function(e){
    var nav = e.target.closest('[data-go]');
    if(nav){ go(nav.getAttribute('data-go')); return; }

    var rc = e.target.closest('[data-rc]');
    if(rc){
      rc.parentElement.querySelectorAll('[data-rc]').forEach(function(x){ x.classList.remove('sel'); });
      rc.classList.add('sel');
      var ty = rc.getAttribute('data-type');
      var l1 = document.getElementById('dt-label'), l2 = document.getElementById('dt-label2');
      var nm = document.getElementById('dc-name'), o = document.getElementById('dc-out');
      if(l1) l1.textContent = ty;
      if(l2) l2.textContent = ty;
      if(nm) nm.textContent = (ty==='УІ'?'UI':ty==='УГІ'?'UGI':'EM')+'_deactivation_20260924.xml';
